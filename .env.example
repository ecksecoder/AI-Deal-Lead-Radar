# Telegram Bot Authentication (from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Telegram User IDs (comma-separated integers for RBAC)
ADMIN_IDS=123456789,987654321

# Google Gemini API Key (optional: if omitted or quota exhausted, local deterministic heuristic scorer is used)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Radar Engine Settings
DB_PATH=radar_state.db
EXPORT_DIR=exports
POLL_INTERVAL_SECONDS=300
HTTP_TIMEOUT=15.0
MIN_ALERT_SCORE=60
